# ============================================================
#  Rate Shopper v2  -  NEW INSTANCE
#  Copy to .env and fill in. Never commit the real .env.
# ============================================================

APP_NAME="Rate Shopper"
APP_ENV=production
# Generate with: php artisan key:generate
APP_KEY=
APP_DEBUG=false

# >>> The domain THIS instance runs on. Must be https and correct:
# >>> it is what carrier callback URLs are built from.
APP_URL=https://rates2.yourdomain.com

LOG_CHANNEL=daily
LOG_LEVEL=error
# 'daily' + this keeps logs rotating. The old server grew a 5.2 GB laravel.log.
LOG_DAILY_DAYS=7

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rateshopper
DB_USERNAME=
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# ============================================================
#  Shopify
#  Per-store Client ID / Secret are entered in the UI, not here.
#  This only pins the Admin API version used for all calls.
# ============================================================
SHOPIFY_API_VERSION=2025-10

# ============================================================
#  Carrier credentials - copy from your existing server.
#  ROTATE THESE: the old values were committed in .env.sample.
# ============================================================

# UPS
UPS_USER_ID=
UPS_PASSWORD=
UPS_SHIPPER_NUMBER=
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
UPS_SANDBOX_URL="https://wwwcie.ups.com"
UPS_LIVE_URL="https://onlinetools.ups.com"

# FedEx
FEDEX_API_KEY=
FEDEX_SECRET_KEY=
FEDEX_ACCOUNT_NO=
FEDEX_SANDBOX_URL="https://apis-sandbox.fedex.com"
FEDEX_LIVE_URL="https://apis.fedex.com"

# USPS via ShipStation
USPS_API_KEY=
USPS_API_SECRET_KEY=
USPS_LIVE_URL="https://ssapi.shipstation.com"
SHIPSTATION_PARTNER=

# Telescope is a debug tool - keep OFF in production.
TELESCOPE_ENABLED=false

HTTP_TIMEOUT=5
HTTP_CONNECT=5
